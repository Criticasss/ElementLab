{
  "entities": {
    "broadcast": {
      "title": "Broadcast Message",
      "description": "A real-time administrative announcement or marquee message shown to all users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "message": { "type": "string" },
        "author": { "type": "string" },
        "timestamp": { "type": "integer" }
      },
      "required": ["message", "author", "timestamp"]
    },
    "account": {
      "title": "Alchemist Account",
      "description": "User alchemist account details featuring score, gems, custom relics, purchased potions, and account login password",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "highscore": { "type": "integer" },
        "gamesPlayed": { "type": "integer" },
        "etherGems": { "type": "integer" },
        "tutorialCompleted": { "type": "boolean" },
        "relics": { "type": "array", "items": { "type": "string" } },
        "redeemedCodes": { "type": "array", "items": { "type": "string" } },
        "potions": {
          "type": "object",
          "properties": {
            "midas": { "type": "integer" },
            "time": { "type": "integer" },
            "chaos": { "type": "integer" }
          }
        }
      },
      "required": ["username", "password", "highscore", "gamesPlayed"]
    },
    "promo_code": {
      "title": "Promo Code",
      "description": "A promotional / gift code created by admins that users can redeem for in-game rewards",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "rewardType": { "type": "string", "enum": ["gems", "potions", "all_relics"] },
        "gemsValue": { "type": "integer" },
        "potionsValue": { "type": "integer" },
        "createdAt": { "type": "integer" },
        "isActive": { "type": "boolean" }
      },
      "required": ["code", "rewardType", "createdAt"]
    },
    "duel": {
      "title": "Alchemical Duel Match",
      "description": "A turn-based matchup between two player accounts detailing scores, statuses, and winners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "challenger": { "type": "string" },
        "opponent": { "type": "string" },
        "currentPhase": { "type": "integer" },
        "challengerStatus": { "type": "string", "enum": ["playing", "passed", "eliminated"] },
        "opponentStatus": { "type": "string", "enum": ["playing", "passed", "eliminated"] },
        "challengerScores": { "type": "object" },
        "opponentScores": { "type": "object" },
        "status": { "type": "string", "enum": ["pending", "active", "completed"] },
        "winner": { "type": "string" },
        "noModifiers": { "type": "boolean" },
        "chat": {
          "type": "array",
          "items": { "type": "object" }
        },
        "createdAt": { "type": "integer" },
        "lastUpdated": { "type": "integer" }
      },
      "required": ["id", "challenger", "opponent", "currentPhase", "challengerStatus", "opponentStatus", "status", "createdAt", "lastUpdated"]
    }
  },
  "firestore": {
    "/broadcasts/{broadcastId}": {
      "schema": "broadcast",
      "description": "The broadcast documents of the application used for real-time announcements."
    },
    "/accounts/{username}": {
      "schema": "account",
      "description": "Alchemist character account profiles."
    },
    "/promo_codes/{code}": {
      "schema": "promo_code",
      "description": "Gift promo codes generated for promotional campaigns."
    },
    "/duels/{duelId}": {
      "schema": "duel",
      "description": "Turn-based dual challenges arranged between two alchemist accounts."
    }
  }
}
