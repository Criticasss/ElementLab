rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\s@#]+$');
    }

    function isValidUsernameId(id) {
      return id is string && id.size() >= 1 && id.size() <= 40;
    }

    function isValidBroadcast(data) {
      return data.keys().hasAll(['message', 'author', 'timestamp'])
        && data.keys().size() == 3
        && data.message is string && data.message.size() <= 300
        && data.author is string && data.author.size() <= 100
        && data.timestamp is int;
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['username', 'password', 'highscore', 'gamesPlayed'])
        && data.username is string && data.username.size() <= 40
        && data.password is string && data.password.size() <= 100
        && data.highscore is int
        && data.gamesPlayed is int
        && (!data.keys().hasAny(['tutorialCompleted']) || data.tutorialCompleted is bool)
        && (!data.keys().hasAny(['redeemedCodes']) || data.redeemedCodes is list);
    }

    function isValidPromoCode(data) {
      return data.keys().hasAll(['code', 'rewardType', 'createdAt'])
        && data.code is string && data.code.size() <= 40
        && data.rewardType is string && (data.rewardType == 'gems' || data.rewardType == 'potions' || data.rewardType == 'all_relics')
        && data.createdAt is int
        && (!data.keys().hasAny(['gemsValue']) || data.gemsValue is int)
        && (!data.keys().hasAny(['potionsValue']) || data.potionsValue is int)
        && (!data.keys().hasAny(['isActive']) || data.isActive is bool);
    }

    function isValidDuel(data) {
      return data.id is string && data.id.size() <= 128
        && data.challenger is string && data.challenger.size() <= 128
        && data.opponent is string && data.opponent.size() <= 128
        && data.currentPhase is int
        && data.challengerStatus is string && (data.challengerStatus == 'playing' || data.challengerStatus == 'passed' || data.challengerStatus == 'eliminated')
        && data.opponentStatus is string && (data.opponentStatus == 'playing' || data.opponentStatus == 'passed' || data.opponentStatus == 'eliminated')
        && data.status is string && (data.status == 'pending' || data.status == 'active' || data.status == 'completed')
        && data.createdAt is int
        && data.lastUpdated is int
        && (!data.keys().hasAny(['noModifiers']) || data.noModifiers is bool)
        && (!data.keys().hasAny(['chat']) || data.chat is list);
    }

    match /broadcasts/{broadcastId} {
      allow get, list: if true;
      allow create, update: if isValidId(broadcastId) && isValidBroadcast(request.resource.data);
      allow delete: if isValidId(broadcastId);
    }

    match /accounts/{username} {
      allow get, list: if true;
      allow create, update: if isValidUsernameId(username) && isValidAccount(request.resource.data);
      allow delete: if isValidUsernameId(username);
    }

    match /promo_codes/{code} {
      allow get, list: if true;
      allow create, update: if isValidId(code) && isValidPromoCode(request.resource.data);
      allow delete: if isValidId(code);
    }

    match /duels/{duelId} {
      allow get, list: if true;
      allow create, update: if duelId is string && duelId.size() <= 128 && isValidDuel(request.resource.data);
      allow delete: if duelId is string && duelId.size() <= 128;
    }
  }
}
